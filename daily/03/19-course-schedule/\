pub struct Solution;

// 0: not traveled
// 1: visiting
// 2: completed
impl Solution {
    fn dfs(u: usize, graph: &Vec<Vec<usize>>, mut state: &Vec<i32>) -> bool {
        for v in &graph[u] {
            if state[*v] == 1 {
                return false;
            }
        }
        state[u] = 2;
        true
    }

    pub fn can_finish(num_courses: i32, prerequisites: Vec<Vec<i32>>) -> bool {
        let n = num_courses as usize;
        if prerequisites.is_empty() {
            return true;
        }
        let mut graph: Vec<Vec<usize>> = vec![vec![]; n];
        prerequisites.iter().for_each(|p| {
            let v = p[0] as usize;
            let u = p[1] as usize;
            graph[u as usize].push(v);
        });
        let mut state: Vec<i32> = vec![0; n];
        for u in 0..n {
            if !Solution::dfs(u, &graph, &state) {
                return false;
            }
        }
        true
    }
}

